# Every setting with its default. See README.md for what each one does.
# The first run creates .env from these defaults with a random SA_PASSWORD,
# or copy this file to .env and set SA_PASSWORD yourself.
SA_PASSWORD=
SQL_PORT=1433
CONTAINER_NAME=sqlserver
SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PID=Developer
MSSQL_DIR=./mssql
